+"""Current constants are recorded without inventing old training provenance."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+import numpy as np
+
+from beamweaver.constants import mec2, runtime_physics_metadata
